{
  "name": "openbumpplan",
  "version": "0.3.1",
  "private": true,
  "description": "Local-first die/package bump and ball-map planning, checks, optimization, and review",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/cli.mjs check examples/chiplet-demo.json",
    "benchmark": "node scripts/benchmark.mjs",
    "publish:github": "node scripts/publish.mjs",
    "qualify": "node scripts/qualify.mjs",
    "publish:update": "node scripts/publish-update.mjs",
    "verify:release": "node scripts/publish-update.mjs --verify-only",
    "qualify:v03": "node scripts/qualify-v03.mjs",
    "qualify:copper": "node scripts/qualify-copper.mjs"
  }
}
